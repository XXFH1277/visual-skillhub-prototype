# ===== GPT 生图（中转站）=====
IMAGE_API_BASE_URL=https://api.lulucoding.com
IMAGE_API_KEY=
IMAGE_API_MODEL_2K=gpt-image-2.6-sunburst
IMAGE_API_MODEL_4K=gpt-image-2.0
GENERATION_PROVIDER=api
# 一个任务里同时出几张（1–6，默认 3）；中转站限流时调小
# IMAGE_API_CONCURRENCY=3

# ===== Kimi（看原图 + 文案策划 + 文字校对）=====
# 用中转站的 Kimi：填中转站地址；用 Kimi 官方：https://api.moonshot.cn
KIMI_API_BASE_URL=https://api.lulucoding.com
KIMI_API_KEY=
KIMI_MODEL=kimi-k3.1-pro

# ===== 网站 =====
PORT=8787
# ACCESS_CODE=
# PUBLIC_ORIGIN=
GENERATION_TIMEOUT_MS=900000

# Set 1 to use API keys for all generation, including style covers.
API_ONLY=0
