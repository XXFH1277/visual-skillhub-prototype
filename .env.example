# Node.js 24+; copy to .env only if overrides are needed.
PORT=8787
# Leave unset to create .data/access-code.txt on first start.
# ACCESS_CODE=choose-a-long-random-secret-at-least-16-characters
# Set your exact HTTPS tunnel/domain URL before public access.
# PUBLIC_ORIGIN=https://your-host.trycloudflare.com
# Native executable or codex.js, not a .cmd shell wrapper.
# CODEX_BIN=C:/path/to/codex.exe
GENERATION_TIMEOUT_MS=900000
# Default for new workspaces; the website can persist a different default.
GENERATION_PROVIDER=codex
# Image relay configuration stays on the server. Do not use VITE_ prefixes.
# IMAGE_API_BASE_URL=https://api.lulucoding.com
# IMAGE_API_KEY=your-image-api-key
# Current relay model IDs; inspect /v1/models when the provider changes aliases.
# IMAGE_API_MODEL_2K=gpt-image-2.5-sunburst
# IMAGE_API_MODEL_4K=gpt-image-2.0
